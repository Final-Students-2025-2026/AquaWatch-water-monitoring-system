# Django secret key - use a long random string
SECRET_KEY=change-me-to-a-long-random-string

# Set to True for local development, False in production
DEBUG=True

# Postgres connection string
DATABASE_URL=postgresql://user:password@host:5432/aquawatch

# Admin account created by `python manage.py create_admin`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
