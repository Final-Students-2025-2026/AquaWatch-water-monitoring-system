{
  "name": "aquawatch-desktop",
  "version": "1.0.0",
  "description": "AquaWatch - IoT Water Quality Monitoring System (desktop application)",
  "author": "Dennis Opoku Amponsah & Okoi Ampomaa Judith",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.aquawatch.desktop",
    "productName": "AquaWatch",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "web/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "AquaWatch-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
